# Öffentliche Strapi-URL (vom Next-Server aus erreichbar)
STRAPI_URL=http://localhost:1337

# Ursprung des Strapi-Admin (für CSP frame-ancestors, damit die Vorschau im iframe lädt)
STRAPI_ADMIN_ORIGIN=http://localhost:1337

# Settings → API Tokens: für Entwurfs-Vorschau „Full access" oder Custom mit Draft (Read-only → oft 404)
STRAPI_API_TOKEN=

# Gemeinsames Geheimnis für Preview-Links — muss mit Strapi .env PREVIEW_SECRET übereinstimmen
PREVIEW_SECRET=
